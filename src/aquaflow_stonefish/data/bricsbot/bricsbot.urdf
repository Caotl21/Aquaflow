<?xml version="1.0"?>
<robot name="bricsbot">
  <link name="base_link">
    <visual>
      <!-- CAD: +X forward, +Z up.  Stonefish: +X forward, +Z down (NED).
           Flip only the vertical axis; do not yaw the visual mesh. -->
      <origin xyz="-0.0008 0.0553 0.0023" rpy="3.141592653589793 0 0"/>
      <geometry>
        <mesh filename="package://aquaflow_stonefish/data/bricsbot/bot_shark_stonefish.obj" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>
</robot>
