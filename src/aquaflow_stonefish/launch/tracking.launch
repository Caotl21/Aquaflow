<?xml version="1.0"?>
<launch>
  <arg name="scene" default="random_pillars"/>
  <arg name="trajectory_type" default="line"
       doc="Nominal trajectory: line or figure_eight"/>
  <arg name="reference_topic" default="/aquaflow/nominal_path"
       doc="Tracking reference: nominal path or /aquaflow/teacher_reference"/>
  <arg name="enable" default="false"
       doc="Set true only after checking the scene and low-amplitude command path."/>
  <arg name="vehicle_name" default="bricsbot"/>
  <arg name="vehicle_model" default="bricsbot"
       doc="bluerov2 uses 8-thruster allocator; bricsbot uses the measured 6-thruster allocator."/>
  <include file="$(find aquaflow_stonefish)/launch/aquaflow_pool.launch">
    <arg name="scene" value="$(arg scene)"/>
    <arg name="vehicle_model" value="$(arg vehicle_model)"/>
  </include>

  <node pkg="aquaflow_stonefish" type="nominal_reference_publisher.py"
        name="nominal_reference_publisher" output="screen">
    <param name="trajectory_type" value="$(arg trajectory_type)"/>
  </node>
  <node pkg="aquaflow_stonefish" type="planar_pid_tracker.py"
        name="planar_pid_tracker" output="screen">
    <param name="vehicle_name" value="$(arg vehicle_name)"/>
    <param name="kp_z" value="3.0"/>
    <param name="kd_z" value="1.0"/>
    <param name="ki_z" value="0.5"/>
    <param name="z_integral_limit" value="5.0"/>
    <param name="yaw_deadband_deg" value="0.0"/>
    <param name="reference_topic" value="$(arg reference_topic)"/>
  </node>
  <node pkg="aquaflow_stonefish" type="actual_path_recorder.py"
        name="actual_path_recorder" output="screen">
    <param name="vehicle_name" value="$(arg vehicle_name)"/>
    <param name="min_distance" value="0.05"/>
    <param name="max_points" value="2000"/>
  </node>
  <node if="$(eval arg('vehicle_model') == 'bluerov2')"
        pkg="aquaflow_stonefish" type="blue8_thruster_allocator.py"
        name="blue8_thruster_allocator" output="screen">
    <param name="vehicle_name" value="$(arg vehicle_name)"/>
    <param name="enabled" value="$(arg enable)"/>
  </node>
  <node if="$(eval arg('vehicle_model') == 'bricsbot')"
        pkg="aquaflow_stonefish" type="brics6_thruster_allocator.py"
        name="brics6_thruster_allocator" output="screen">
    <param name="vehicle_name" value="$(arg vehicle_name)"/>
    <param name="enabled" value="$(arg enable)"/>
  </node>
</launch>
