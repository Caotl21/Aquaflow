		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="-0.042 -1.742 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar07" type="cylinder">
		<dimensions radius="0.2973" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="1.982 1.206 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar08" type="cylinder">
		<dimensions radius="0.1941" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="-1.502 -0.459 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar09" type="cylinder">
		<dimensions radius="0.2581" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="3.714 1.294 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar10" type="cylinder">
		<dimensions radius="0.2980" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="2.663 -1.931 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar11" type="cylinder">
		<dimensions radius="0.2735" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="-3.306 1.526 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar12" type="cylinder">
		<dimensions radius="0.2956" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="-0.825 2.192 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar13" type="cylinder">
		<dimensions radius="0.1722" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="-2.463 -2.097 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar14" type="cylinder">
		<dimensions radius="0.1786" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="-1.291 -2.016 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar15" type="cylinder">
		<dimensions radius="0.2951" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="-3.443 -1.201 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<include file="$(find aquaflow_stonefish)/scenarios/bricsbot_bearing_reference.scn">
		<arg name="vehicle_name" value="bricsbot"/>
		<arg name="position" value="-5.0 0.0 1.0"/>
		<arg name="orientation" value="0.0 0.0 0.0"/>
	</include>
</scenario>
