<?xml version="1.0"?>
<launch>
  <arg name="simulation_rate" default="100.0"/>
  <arg name="graphics_resolution" default="1400 900"/>
  <arg name="graphics_quality" default="medium"/>
  <arg name="headless" default="false"/>

  <include unless="$(arg headless)" file="$(find stonefish_ros)/launch/simulator.launch">
    <arg name="simulation_data" value="$(find aquaflow_stonefish)/data"/>
    <arg name="scenario_description" value="$(find aquaflow_stonefish)/scenarios/auv_mapf_asset_preview.scn"/>
    <arg name="simulation_rate" value="$(arg simulation_rate)"/>
    <arg name="graphics_resolution" value="$(arg graphics_resolution)"/>
    <arg name="graphics_quality" value="$(arg graphics_quality)"/>
  </include>

  <include if="$(arg headless)" file="$(find stonefish_ros)/launch/simulator_nogpu.launch">
    <arg name="simulation_data" value="$(find aquaflow_stonefish)/data"/>
    <arg name="scenario_description" value="$(find aquaflow_stonefish)/scenarios/auv_mapf_asset_preview.scn"/>
    <arg name="simulation_rate" value="$(arg simulation_rate)"/>
  </include>

  <node pkg="tf2_ros" type="static_transform_publisher"
        name="bricsbot_camera_front_tf"
        args="0.20 0.0 -0.03 1.5707963268 0.0 1.5707963268 bricsbot/base_link bricsbot/camera_front"/>
</launch>
