<?xml version="1.0"?>
<launch>
  <arg name="map_file"
       default="$(find aquaflow_ref)/config/random_pillars.yaml"/>
  <arg name="vehicle_name" default="bluerov2"/>
  <rosparam command="load" file="$(arg map_file)" ns="/privileged_teacher"/>
  <rosparam command="load" file="$(arg map_file)" ns="/privileged_map_visualizer"/>
  <node pkg="aquaflow_ref" type="privileged_teacher.py"
        name="privileged_teacher" output="screen">
    <param name="vehicle_name" value="$(arg vehicle_name)"/>
  </node>
  <node pkg="aquaflow_ref" type="privileged_map_visualizer.py"
        name="privileged_map_visualizer" output="screen"/>
</launch>
