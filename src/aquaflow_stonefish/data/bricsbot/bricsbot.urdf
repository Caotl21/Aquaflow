<?xml version="1.0"?>
<robot name="bricsbot">
  <link name="base_link">
    <visual>
      <!-- The source mesh has +X forward and +Y up.  RViz uses the same
           world_ned/body convention as the Stonefish TF here (+Z down), so
           map mesh +Y to body -Z with one -90 degree roll. -->
      <origin xyz="-0.0008 0.0 -0.0020"
              rpy="-1.5707963267948966 0 -1.5707963267948966"/>
      <geometry>
        <mesh filename="package://aquaflow_stonefish/data/bricsbot/bot_shark_stonefish.obj" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>
</robot>
