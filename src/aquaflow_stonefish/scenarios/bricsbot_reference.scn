<?xml version="1.0"?>
<!-- Initial Stonefish model for the laboratory six-thruster BricsBot.
     Body frame: x forward, y starboard, z down (NED).  The external OBJ is the
     visual/physical envelope; the internal boxes are deliberately explicit so
     mass and slight-positive buoyancy can be tuned without re-exporting CAD. -->
<scenario>
  <looks>
    <look name="bricsbot_body" gray="1.0" texture="bricsbot/bricsbot.png" roughness="0.45" metalness="0.15"/>
    <look name="bricsbot_dark" rgb="0.08 0.10 0.12" roughness="0.55" metalness="0.25"/>
  </looks>

  <robot name="$(arg vehicle_name)" fixed="false" self_collisions="false">
    <ros_base_link_transforms publish="true"/>
    <base_link name="base_link" type="compound" physics="submerged">
      <external_part name="BricsBotHull" type="model" physics="submerged" buoyant="false">
        <physical>
          <mesh filename="bricsbot/bricsbot_collision_candidate.obj" scale="1.0"/>
          <origin xyz="0 0 0" rpy="-1.5707963267948966 0 0"/>
          <thickness value="0.004"/>
        </physical>
        <visual>
          <mesh filename="bricsbot/bricsbot_stonefish_baked.obj" scale="1.0"/>
          <!-- Centre the converted mesh's bounding box on base_link. -->
          <!-- bricsbot.obj has +X forward and +Y up after its Blender
               alignment.  Stonefish uses NED (+Z down): rotate the visual
               mesh only, so its horizontal thruster plane becomes body XY. -->
          <origin xyz="-0.0008 0.0 -0.0020" rpy="-1.5707963267948966 0 0"/>
        </visual>
        <material name="Fiberglass"/>
        <look name="bricsbot_body"/>
        <!-- The collision shell is only a geometric envelope.  Explicitly
             constrain its mass; otherwise Stonefish estimates several kg
             from Fiberglass density and shell thickness. -->
        <mass value="0.50"/>
        <compound_transform xyz="0 0 0" rpy="0 0 0"/>
      </external_part>

      <!-- Approximate 7.95 kg total air mass.  The external collision shell
           contributes 0.50 kg; the remaining 7.44 kg is concentrated below
           the body origin to provide a stable CG/CB separation. -->
      <internal_part name="BricsBotMass" type="box" physics="submerged" buoyant="false">
        <dimensions xyz="0.374 0.358 0.058"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <material name="Steel"/>
        <look name="None"/>
        <mass value="7.44"/>
        <compound_transform xyz="0 0 0.030" rpy="0 0 0"/>
      </internal_part>
      <internal_part name="BricsBotBuoyancy" type="box" physics="submerged" buoyant="true">
        <!-- 7.775 L displacement: about 0.8% positive in 1031 kg/m^3 water. -->
        <dimensions xyz="0.374 0.358 0.058"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <material name="Neutral"/>
        <look name="None"/>
        <mass value="0.01"/>
        <!-- NED: negative z is above the CG. -->
        <compound_transform xyz="0 0 -0.030" rpy="0 0 0"/>
      </internal_part>
    </base_link>

    <!-- T1..T4: horizontal 45-degree configuration. -->
    <actuator name="T1" type="thruster">
      <link name="base_link"/><origin xyz="0.1278 -0.1278 0" rpy="0 0 0.7853981634"/>
      <specs max_setpoint="376.991118" inverted_setpoint="false" normalized_setpoint="true"/>
      <propeller diameter="0.076" right="true"><mesh filename="bluerov2/ccw.obj" scale="1"/><material name="Neutral"/><look name="bricsbot_dark"/></propeller>
      <rotor_dynamics type="zero_order"/>
      <thrust_model type="linear_interpolation"><input value="-376.991118 -357.149480 -337.307842 -317.466205 -297.624567 -277.782929 -257.941291 -238.099653 -218.258016 -198.416378 -178.574740 -158.733102 -138.891465 -119.049827 -99.208189 -79.366551 -59.524913 -39.683276 -19.841638 0.000000 19.841638 39.683276 59.524913 79.366551 99.208189 119.049827 138.891465 158.733102 178.574740 198.416378 218.258016 238.099653 257.941291 277.782929 297.624567 317.466205 337.307842 357.149480 376.991118"/><output value="-58.839900 -58.839900 -56.878570 -54.917240 -48.052585 -43.149260 -38.245935 -34.323275 -28.439285 -23.535960 -18.632635 -14.709975 -10.787315 -7.845320 -4.903325 -2.941995 -0.980665 0.000000 0.000000 0.000000 0.000000 1.961330 3.922660 7.845320 11.767980 16.671305 20.593965 26.477955 32.361945 37.265270 44.129925 48.052585 53.936575 57.859235 63.743225 64.723890 64.723890 67.665885 67.665885"/></thrust_model>
    </actuator>
    <actuator name="T2" type="thruster">
      <link name="base_link"/><origin xyz="0.1273 0.1273 0" rpy="0 0 2.3561944902"/>
      <specs max_setpoint="376.991118" inverted_setpoint="true" normalized_setpoint="true"/>
      <propeller diameter="0.076" right="false"><mesh filename="bluerov2/cw.obj" scale="1"/><material name="Neutral"/><look name="bricsbot_dark"/></propeller>
      <rotor_dynamics type="zero_order"/>
      <thrust_model type="linear_interpolation"><input value="-376.991118 -357.149480 -337.307842 -317.466205 -297.624567 -277.782929 -257.941291 -238.099653 -218.258016 -198.416378 -178.574740 -158.733102 -138.891465 -119.049827 -99.208189 -79.366551 -59.524913 -39.683276 -19.841638 0.000000 19.841638 39.683276 59.524913 79.366551 99.208189 119.049827 138.891465 158.733102 178.574740 198.416378 218.258016 238.099653 257.941291 277.782929 297.624567 317.466205 337.307842 357.149480 376.991118"/><output value="-58.839900 -58.839900 -56.878570 -54.917240 -48.052585 -43.149260 -38.245935 -34.323275 -28.439285 -23.535960 -18.632635 -14.709975 -10.787315 -7.845320 -4.903325 -2.941995 -0.980665 0.000000 0.000000 0.000000 0.000000 1.961330 3.922660 7.845320 11.767980 16.671305 20.593965 26.477955 32.361945 37.265270 44.129925 48.052585 53.936575 57.859235 63.743225 64.723890 64.723890 67.665885 67.665885"/></thrust_model>
    </actuator>
    <actuator name="T3" type="thruster">
      <link name="base_link"/><origin xyz="-0.1278 -0.1278 0" rpy="0 0 2.3561944902"/>
      <specs max_setpoint="376.991118" inverted_setpoint="false" normalized_setpoint="true"/>
      <propeller diameter="0.076" right="true"><mesh filename="bluerov2/ccw.obj" scale="1"/><material name="Neutral"/><look name="bricsbot_dark"/></propeller>
      <rotor_dynamics type="zero_order"/>
      <thrust_model type="linear_interpolation"><input value="-376.991118 -357.149480 -337.307842 -317.466205 -297.624567 -277.782929 -257.941291 -238.099653 -218.258016 -198.416378 -178.574740 -158.733102 -138.891465 -119.049827 -99.208189 -79.366551 -59.524913 -39.683276 -19.841638 0.000000 19.841638 39.683276 59.524913 79.366551 99.208189 119.049827 138.891465 158.733102 178.574740 198.416378 218.258016 238.099653 257.941291 277.782929 297.624567 317.466205 337.307842 357.149480 376.991118"/><output value="-58.839900 -58.839900 -56.878570 -54.917240 -48.052585 -43.149260 -38.245935 -34.323275 -28.439285 -23.535960 -18.632635 -14.709975 -10.787315 -7.845320 -4.903325 -2.941995 -0.980665 0.000000 0.000000 0.000000 0.000000 1.961330 3.922660 7.845320 11.767980 16.671305 20.593965 26.477955 32.361945 37.265270 44.129925 48.052585 53.936575 57.859235 63.743225 64.723890 64.723890 67.665885 67.665885"/></thrust_model>
    </actuator>
    <actuator name="T4" type="thruster">
      <link name="base_link"/><origin xyz="-0.1273 0.1273 0" rpy="0 0 0.7853981634"/>
      <specs max_setpoint="376.991118" inverted_setpoint="true" normalized_setpoint="true"/>
      <propeller diameter="0.076" right="false"><mesh filename="bluerov2/cw.obj" scale="1"/><material name="Neutral"/><look name="bricsbot_dark"/></propeller>
      <rotor_dynamics type="zero_order"/>
      <thrust_model type="linear_interpolation"><input value="-376.991118 -357.149480 -337.307842 -317.466205 -297.624567 -277.782929 -257.941291 -238.099653 -218.258016 -198.416378 -178.574740 -158.733102 -138.891465 -119.049827 -99.208189 -79.366551 -59.524913 -39.683276 -19.841638 0.000000 19.841638 39.683276 59.524913 79.366551 99.208189 119.049827 138.891465 158.733102 178.574740 198.416378 218.258016 238.099653 257.941291 277.782929 297.624567 317.466205 337.307842 357.149480 376.991118"/><output value="-58.839900 -58.839900 -56.878570 -54.917240 -48.052585 -43.149260 -38.245935 -34.323275 -28.439285 -23.535960 -18.632635 -14.709975 -10.787315 -7.845320 -4.903325 -2.941995 -0.980665 0.000000 0.000000 0.000000 0.000000 1.961330 3.922660 7.845320 11.767980 16.671305 20.593965 26.477955 32.361945 37.265270 44.129925 48.052585 53.936575 57.859235 63.743225 64.723890 64.723890 67.665885 67.665885"/></thrust_model>
    </actuator>

    <!-- T5/T6: the two vertical motors.  Rotation about y maps local +x to
         -z for T5 and +z for T6, matching the measured force directions. -->
    <actuator name="T5" type="thruster">
      <link name="base_link"/><origin xyz="0 -0.1235 0" rpy="0 1.5707963268 0"/>
      <specs max_setpoint="376.991118" inverted_setpoint="false" normalized_setpoint="true"/>
      <propeller diameter="0.076" right="true"><mesh filename="bluerov2/ccw.obj" scale="1"/><material name="Neutral"/><look name="bricsbot_dark"/></propeller>
      <rotor_dynamics type="zero_order"/>
      <thrust_model type="linear_interpolation"><input value="-376.991118 -357.149480 -337.307842 -317.466205 -297.624567 -277.782929 -257.941291 -238.099653 -218.258016 -198.416378 -178.574740 -158.733102 -138.891465 -119.049827 -99.208189 -79.366551 -59.524913 -39.683276 -19.841638 0.000000 19.841638 39.683276 59.524913 79.366551 99.208189 119.049827 138.891465 158.733102 178.574740 198.416378 218.258016 238.099653 257.941291 277.782929 297.624567 317.466205 337.307842 357.149480 376.991118"/><output value="-58.839900 -58.839900 -56.878570 -54.917240 -48.052585 -43.149260 -38.245935 -34.323275 -28.439285 -23.535960 -18.632635 -14.709975 -10.787315 -7.845320 -4.903325 -2.941995 -0.980665 0.000000 0.000000 0.000000 0.000000 1.961330 3.922660 7.845320 11.767980 16.671305 20.593965 26.477955 32.361945 37.265270 44.129925 48.052585 53.936575 57.859235 63.743225 64.723890 64.723890 67.665885 67.665885"/></thrust_model>
    </actuator>
    <actuator name="T6" type="thruster">
      <link name="base_link"/><origin xyz="0 0.1235 0" rpy="0 -1.5707963268 0"/>
      <specs max_setpoint="376.991118" inverted_setpoint="true" normalized_setpoint="true"/>
      <propeller diameter="0.076" right="false"><mesh filename="bluerov2/cw.obj" scale="1"/><material name="Neutral"/><look name="bricsbot_dark"/></propeller>
      <rotor_dynamics type="zero_order"/>
      <thrust_model type="linear_interpolation"><input value="-376.991118 -357.149480 -337.307842 -317.466205 -297.624567 -277.782929 -257.941291 -238.099653 -218.258016 -198.416378 -178.574740 -158.733102 -138.891465 -119.049827 -99.208189 -79.366551 -59.524913 -39.683276 -19.841638 0.000000 19.841638 39.683276 59.524913 79.366551 99.208189 119.049827 138.891465 158.733102 178.574740 198.416378 218.258016 238.099653 257.941291 277.782929 297.624567 317.466205 337.307842 357.149480 376.991118"/><output value="-58.839900 -58.839900 -56.878570 -54.917240 -48.052585 -43.149260 -38.245935 -34.323275 -28.439285 -23.535960 -18.632635 -14.709975 -10.787315 -7.845320 -4.903325 -2.941995 -0.980665 0.000000 0.000000 0.000000 0.000000 1.961330 3.922660 7.845320 11.767980 16.671305 20.593965 26.477955 32.361945 37.265270 44.129925 48.052585 53.936575 57.859235 63.743225 64.723890 64.723890 67.665885 67.665885"/></thrust_model>
    </actuator>

    <sensor name="odometry" type="odometry" rate="100.0">
      <link name="base_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <ros_publisher topic="/$(arg vehicle_name)/odometry"/>
    </sensor>

    <sensor name="pressure" type="pressure" rate="5.0">
      <link name="base_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <ros_publisher topic="/$(arg vehicle_name)/pressure"/>
    </sensor>

    <world_transform xyz="$(arg position)" rpy="$(arg orientation)"/>
    <ros_subscriber thrusters="/$(arg vehicle_name)/setpoint/pwm"/>
  </robot>
</scenario>
