		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="0.438 2.195 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar05" type="cylinder">
		<dimensions radius="0.1938" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="-1.383 -1.956 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar06" type="cylinder">
		<dimensions radius="0.1713" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="2.501 -1.086 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar07" type="cylinder">
		<dimensions radius="0.1855" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="-3.165 -1.547 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar08" type="cylinder">
		<dimensions radius="0.2870" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="-0.890 0.287 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar09" type="cylinder">
		<dimensions radius="0.1948" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="1.114 -1.298 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar10" type="cylinder">
		<dimensions radius="0.2515" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="2.628 1.847 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar11" type="cylinder">
		<dimensions radius="0.2539" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="3.284 -2.006 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar12" type="cylinder">
		<dimensions radius="0.2669" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="-1.145 1.632 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar13" type="cylinder">
		<dimensions radius="0.1753" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="-2.614 2.270 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar14" type="cylinder">
		<dimensions radius="0.1564" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="0.119 -1.954 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar15" type="cylinder">
		<dimensions radius="0.1968" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="3.655 1.220 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<include file="$(find aquaflow_stonefish)/scenarios/bricsbot_bearing_reference.scn">
		<arg name="vehicle_name" value="bricsbot"/>
		<arg name="position" value="-5.0 0.0 1.0"/>
		<arg name="orientation" value="0.0 0.0 0.0"/>
	</include>
</scenario>
