		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="-3.324 1.595 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar05" type="cylinder">
		<dimensions radius="0.1513" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="-3.064 -2.200 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar06" type="cylinder">
		<dimensions radius="0.1885" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="1.036 -0.782 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar07" type="cylinder">
		<dimensions radius="0.1863" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="-0.155 0.600 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar08" type="cylinder">
		<dimensions radius="0.1529" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="-1.034 -1.605 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar09" type="cylinder">
		<dimensions radius="0.1840" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="3.804 -1.604 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar10" type="cylinder">
		<dimensions radius="0.1618" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="1.831 1.874 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar11" type="cylinder">
		<dimensions radius="0.2588" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="-1.930 1.889 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar12" type="cylinder">
		<dimensions radius="0.1902" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="1.050 0.916 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar13" type="cylinder">
		<dimensions radius="0.1785" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="2.143 -0.628 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar14" type="cylinder">
		<dimensions radius="0.2151" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="2.786 -2.237 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar15" type="cylinder">
		<dimensions radius="0.2800" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="3.393 1.402 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<include file="$(find aquaflow_stonefish)/scenarios/bricsbot_bearing_reference.scn">
		<arg name="vehicle_name" value="bricsbot"/>
		<arg name="position" value="-5.0 0.0 1.0"/>
		<arg name="orientation" value="0.0 0.0 0.0"/>
	</include>
</scenario>
