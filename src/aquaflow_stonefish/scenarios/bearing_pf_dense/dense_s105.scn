<?xml version="1.0"?>
<!--
  AquaFlow bearing-angle PF dense random course (seed 105), generated by
  scripts/generate_bearing_pf_scenes.py.  Diameters 0.30-0.60 m; robot starts at
  (-5, 0), goal (5, 0).  NED: z=0 surface, z=4 m pool floor.
-->
<scenario>
	<environment>
		<ned latitude="56.136459" longitude="-2.706819"/>
		<ocean>
			<water density="1031.0" jerlov="0.15"/>
			<waves height="0.0"/>
			<particles enabled="false"/>
			<current type="uniform">
				<velocity xyz="0.0 0.0 0.0"/>
			</current>
		</ocean>
		<atmosphere>
			<sun azimuth="45.0" elevation="60.0"/>
		</atmosphere>
	</environment>

	<materials>
		<material name="Neutral" density="1000.0" restitution="0.1"/>
		<material name="Rock" density="3000.0" restitution="0.2"/>
		<material name="Fiberglass" density="1500.0" restitution="0.3"/>
		<material name="Aluminium" density="2710.0" restitution="0.5"/>
		<friction_table>
			<friction material1="Neutral" material2="Neutral" static="0.5" dynamic="0.2"/>
			<friction material1="Neutral" material2="Rock" static="0.2" dynamic="0.1"/>
			<friction material1="Neutral" material2="Fiberglass" static="0.5" dynamic="0.2"/>
			<friction material1="Neutral" material2="Aluminium" static="0.1" dynamic="0.02"/>
			<friction material1="Rock" material2="Rock" static="0.9" dynamic="0.7"/>
			<friction material1="Rock" material2="Fiberglass" static="0.6" dynamic="0.4"/>
			<friction material1="Rock" material2="Aluminium" static="0.6" dynamic="0.3"/>
			<friction material1="Fiberglass" material2="Fiberglass" static="0.5" dynamic="0.2"/>
			<friction material1="Fiberglass" material2="Aluminium" static="0.5" dynamic="0.2"/>
			<friction material1="Aluminium" material2="Aluminium" static="0.8" dynamic="0.5"/>
		</friction_table>
	</materials>

	<looks>
		<!-- Robot looks required by the included BlueROV2 description. -->
		<look name="black" gray="0.05" roughness="0.2"/>
		<look name="yellow" rgb="1.0 0.9 0.0" roughness="0.3"/>
		<look name="gray" gray="0.5" roughness="0.4" metalness="0.5"/>

		<look name="pool_floor" rgb="0.64 0.72 0.70" roughness="0.95"/>
		<look name="pool_wall" rgb="0.82 0.90 0.92" roughness="0.85"/>
		<look name="pillar_black" gray="0.01" roughness="0.70" metalness="0.0"/>
	</looks>

	<!-- 14 m x 8 m pool, 4 m water depth. -->
	<static name="PoolFloor" type="box">
		<dimensions xyz="14.0 8.0 0.2"/>
		<material name="Rock"/>
		<look name="pool_floor"/>
		<world_transform xyz="0.0 0.0 4.1" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="PoolWallStart" type="box">
		<dimensions xyz="0.2 8.4 4.0"/>
		<material name="Rock"/>
		<look name="pool_wall"/>
		<world_transform xyz="-7.1 0.0 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="PoolWallEnd" type="box">
		<dimensions xyz="0.2 8.4 4.0"/>
		<material name="Rock"/>
		<look name="pool_wall"/>
		<world_transform xyz="7.1 0.0 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="PoolWallLeft" type="box">
		<dimensions xyz="14.0 0.2 4.0"/>
		<material name="Rock"/>
		<look name="pool_wall"/>
		<world_transform xyz="0.0 -4.1 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="PoolWallRight" type="box">
		<dimensions xyz="14.0 0.2 4.0"/>
		<material name="Rock"/>
		<look name="pool_wall"/>
		<world_transform xyz="0.0 4.1 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<!-- Dense random layout, seed 105: 15 pillars, minimum surface gap 0.75 m. -->

	<static name="BearingPillar01" type="cylinder">
		<dimensions radius="0.1645" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="1.186 0.393 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar02" type="cylinder">
		<dimensions radius="0.2418" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="3.025 0.032 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar03" type="cylinder">
		<dimensions radius="0.2601" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="-1.460 0.045 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar04" type="cylinder">
		<dimensions radius="0.1988" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="-2.108 -1.082 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar05" type="cylinder">
		<dimensions radius="0.2781" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="0.853 1.653 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar06" type="cylinder">
		<dimensions radius="0.2831" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="2.406 -2.154 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar07" type="cylinder">
		<dimensions radius="0.2587" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="0.061 -0.345 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar08" type="cylinder">
		<dimensions radius="0.2416" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="-1.685 1.930 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar09" type="cylinder">
		<dimensions radius="0.1912" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="-3.509 -1.111 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar10" type="cylinder">
		<dimensions radius="0.1631" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="0.448 -2.150 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar11" type="cylinder">
		<dimensions radius="0.2931" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="-3.485 2.260 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar12" type="cylinder">
		<dimensions radius="0.1827" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="3.723 2.109 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar13" type="cylinder">
		<dimensions radius="0.2071" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="-0.518 1.101 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar14" type="cylinder">
		<dimensions radius="0.2253" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="1.383 -1.174 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="BearingPillar15" type="cylinder">
		<dimensions radius="0.1823" height="4.0"/>
		<material name="Fiberglass"/>
		<look name="pillar_black"/>
		<world_transform xyz="-0.878 -1.151 2.0" rpy="0.0 0.0 0.0"/>
	</static>

	<include file="$(find aquaflow_stonefish)/scenarios/bricsbot_bearing_reference.scn">
		<arg name="vehicle_name" value="bricsbot"/>
		<arg name="position" value="-5.0 0.0 1.0"/>
		<arg name="orientation" value="0.0 0.0 0.0"/>
	</include>
</scenario>
