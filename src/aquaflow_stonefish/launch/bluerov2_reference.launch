<launch>
  <include file="$(find stonefish_ros)/launch/simulator.launch">
    <arg name="simulation_data"
         value="$(find aquaflow_stonefish)/data"/>

    <arg name="scenario_description"
         value="$(find aquaflow_stonefish)/scenarios/bluerov2_reference_tank.scn"/>

    <arg name="simulation_rate" value="100.0"/>
    <arg name="graphics_resolution" value="1200 800"/>
    <arg name="graphics_quality" value="medium"/>
  </include>
</launch>